# No secrets are required. All settings are optional overrides.
FORMULAFORGE_DATA_DIR=data
FORMULAFORGE_RUNS_DIR=runs
FORMULAFORGE_RUN_DIR=runs/scratch
# Keep Hugging Face downloads (only used by configs/pretrained.yaml) in a project-local cache:
# HF_HOME=.hf_cache
# Run offline once the model is cached:
# HF_HUB_OFFLINE=1
